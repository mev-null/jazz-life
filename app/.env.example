# ====================================================================
# jazz-life 環境変数サンプル
# 使い方: `cp .env.example .env` してから値を埋める
# ====================================================================

# ---------- Spotify ----------
# https://developer.spotify.com/dashboard でアプリを作って取得
# Spotify は 2025-04 以降 redirect_uri に http://localhost を許容しなくなったため、
# loopback IP 表記 (http://127.0.0.1) を使う。Dashboard の Redirect URIs にも
# http://127.0.0.1:8000/api/auth/callback を登録すること。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# 自分の Spotify ID（プロフィール URL の末尾）。これ以外のログインは 403。
ALLOWED_SPOTIFY_USER_ID=

# ---------- Auth ----------
# JWT 署名鍵 (32 文字以上)。生成例:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Spotify refresh_token の DB 保存用 Fernet 鍵 (url-safe base64 32 バイト)。
# 生成例:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REFRESH_TOKEN_KEY=

# OAuth callback 後のフロントエンドへのリダイレクト先。
# Spotify redirect_uri を 127.0.0.1 にしたので、cookie ホスト一致のため frontend も
# 127.0.0.1:5173 経由で開く。
FRONTEND_BASE_URL=http://127.0.0.1:5173

# session cookie の Secure 属性。dev は false、本番デプロイ時は true。
COOKIE_SECURE=false

# ---------- Database ----------
# docker compose の db サービスへ接続。コンテナ間通信のため host=db、5432
# ホスト直接実行（テスト等）の場合は host=localhost に置き換える
DATABASE_URL=postgresql+psycopg://jazz:jazz@db:5432/jazz
# pytest 用。同インスタンス内に initdb で作られる別 DB
TEST_DATABASE_URL=postgresql+psycopg://jazz:jazz@db:5432/jazz_test

# ---------- Frontend ----------
# Phase B-2 PR-B 以降は実 API 接続が既定。UI 単独でいじりたい時のみ true に戻す。
# OAuth cookie ホスト一致のため backend も 127.0.0.1 経由で叩く。
VITE_USE_MOCK=false
VITE_API_BASE=http://127.0.0.1:8000
