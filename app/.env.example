# ====================================================================
# jazz-life — environment variables
#
# Copy to `app/.env` and fill in the blanks:  cp app/.env.example app/.env
# docker compose picks `app/.env` up automatically for variable interpolation
# in app/docker-compose.yml. In GitHub Codespaces the same names are provided
# by .devcontainer/devcontainer.json (containerEnv) + Codespaces user secrets,
# so no .env file is needed there.
#
# Frontend-only work: set VITE_USE_MOCK=true and nothing else is required.
# ====================================================================

# ---------- Spotify (https://developer.spotify.com/dashboard) ----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered in the Spotify dashboard EXACTLY.
# Spotify no longer accepts http://localhost — use the loopback IP.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# ---------- Auth ----------
# JWT signing key, 32+ characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Fernet key used to encrypt Spotify refresh tokens at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REFRESH_TOKEN_KEY=

# ---------- Audio recognition (optional, https://dashboard.audd.io/) ----------
# Leave empty to disable; POST /api/recognize then answers 503.
AUDD_API_TOKEN=

# ---------- Cookies / CORS ----------
# Where the backend redirects after the OAuth callback. Open the app via
# 127.0.0.1 (not localhost) so the session cookie host matches the redirect URI.
FRONTEND_BASE_URL=http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local dev: false / lax. Cross-origin production: true / none (none requires secure=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Expose /docs, /redoc and /openapi.json. Set to false in production.
EXPOSE_OPENAPI_DOCS=true

# ---------- Database ----------
# Inside docker compose the Postgres service is reachable as host `db`.
# When running pytest or uvicorn on the host, use localhost instead.
DATABASE_URL=postgresql+psycopg://jazz:jazz@db:5432/jazz
TEST_DATABASE_URL=postgresql+psycopg://jazz:jazz@localhost:5432/jazz_test

# ---------- Frontend (Vite, read at build/dev-server start) ----------
VITE_API_BASE=http://127.0.0.1:8000
# true = in-browser demo with sample data, no backend or Spotify login needed.
VITE_USE_MOCK=false
# Extra hostnames the Vite dev server should accept (CSV). Empty = defaults.
VITE_ALLOWED_HOSTS=
