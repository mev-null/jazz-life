          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_ArtistRecordCount_"
                }
              }
            }
          }
        }
      }
    },
    "/api/artists/{spotify_id}": {
      "get": {
        "tags": [
          "artists"
        ],
        "summary": "Get Artist",
        "description": "単一 artist を取り、image_url が NULL なら Spotify から補完する。\n\nArtistDetailModal を開いた時に呼ぶ「lazy photo hydration」エンドポイント。\nSpotify 側エラーは service 層で握り潰されるので、画像が無い場合は\nimage_url=null のまま返る (UI 側で initials fallback)。",
        "operationId": "get_artist_api_artists__spotify_id__get",
        "parameters": [
          {
            "name": "spotify_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Spotify Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/records": {
      "get": {
