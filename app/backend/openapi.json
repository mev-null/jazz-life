  "components": {
    "schemas": {
      "ArtistCreate": {
        "properties": {
          "spotify_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Spotify Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "source": {
            "type": "string",
            "enum": [
              "seeded",
              "spotify_dynamic",
              "manual"
            ],
            "title": "Source",
            "default": "spotify_dynamic"
          }
        },
        "type": "object",
        "required": [
          "spotify_id",
          "name"
        ],
        "title": "ArtistCreate",
        "description": "新規 artist 作成リクエスト。upsert 動作 (spotify_id 既存なら既存を返す)。\n\nPhase B-3 PR-2 の RecordFormModal が Spotify album を選んだ時、\nその album の artist がまだ DB に無い場合に呼び出す。"
      },
      "ArtistRead": {
        "properties": {
          "spotify_id": {
            "type": "string",
            "title": "Spotify Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "source": {
            "type": "string",
            "enum": [
              "seeded",
              "spotify_dynamic",
              "manual"
            ],
            "title": "Source"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "title": "Added At"
          }
        },
        "type": "object",
        "required": [
          "spotify_id",
          "name",
          "image_url",
          "source",
          "added_at"
        ],
        "title": "ArtistRead"
      },
      "ArtistRecordCount": {
        "properties": {
          "artist_id": {
            "type": "string",
            "title": "Artist Id"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "artist_id",
          "count"
        ],
        "title": "ArtistRecordCount",
        "description": "ArtistsPage 一覧の件数列に渡す軽量行。\n\nrecords 本体は ArtistDetailModal を開くまで fetch しない方針のため、\n一覧では「N records」表示だけ別エンドポイント `/api/artists/record-counts`\nから先に取れるようにする。"
      },
      "AuthUserRead": {
        "properties": {
          "spotify_id": {
            "type": "string",
            "title": "Spotify Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "spotify_id",
          "display_name",
          "image_url"
        ],
        "title": "AuthUserRead"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ListResponse_ArtistRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ArtistRead"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ListResponse[ArtistRead]"
      },
      "ListResponse_ArtistRecordCount_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ArtistRecordCount"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ListResponse[ArtistRecordCount]"
      },
      "ListResponse_SpotifyAlbumSummary_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SpotifyAlbumSummary"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ListResponse[SpotifyAlbumSummary]"
      },
      "ListResponse_VinylRecordRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/VinylRecordRead"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ListResponse[VinylRecordRead]"
      },
      "SpotifyAlbumSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "release_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Date"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "artist_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artist Names"
          },
          "primary_artist_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Artist Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "release_date",
          "image_url",
          "artist_names",
          "primary_artist_id"
        ],
        "title": "SpotifyAlbumSummary",
        "description": "Spotify album search 結果の 1 件を表す DTO。\n\n`vinyl_records` への投入で必要なフィールドだけを露出する:\n`spotify_album_id` (= id) / `title` (= name) / `original_release_date` (= release_date)\n/ `image_url` / 表示用の `artist_names` / artist auto-upsert 用の `primary_artist_id`。\n\n`primary_artist_id` は album.artists[0].id (Spotify artist ID)。RecordFormModal が\nalbum 選択時に artists テーブルへ upsert する際、name 一致ではなく Spotify 正規 ID で\n識別するために用いる。album に artists が無いケース (極めて稀) のみ null。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VinylRecordCreate": {
        "properties": {
          "artist_id": {
            "type": "string",
            "title": "Artist Id"
          },
          "spotify_album_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spotify Album Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "spotify",
              "manual"
            ],
            "title": "Source",
            "default": "manual"
          },
          "status": {
            "type": "string",
            "enum": [
              "owned",
              "wanted"
            ],
            "title": "Status",
            "default": "owned"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "original_release_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Release Date"
          },
          "pressing_info": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pressing Info"
          },
          "purchase_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchase Date"
          },
          "purchase_store": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchase Store"
          },
          "purchase_price": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchase Price"
          },
          "purchase_currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Purchase Currency",
            "default": "JPY"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "memo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memo"
          },
          "favorite_tracks": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Favorite Tracks"
          }
        },
        "type": "object",
        "required": [
          "artist_id",
          "title"
        ],
        "title": "VinylRecordCreate"
      },
      "VinylRecordRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "artist_id": {
            "type": "string",
            "title": "Artist Id"
          },
          "spotify_album_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spotify Album Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "spotify",
              "manual"
            ],
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "owned",
              "wanted"
            ],
            "title": "Status"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "original_release_date": {
            "anyOf": [
