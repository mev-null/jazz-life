    "/api/artists": {
      "get": {
        "tags": [
          "artists"
        ],
        "summary": "List Artists",
        "operationId": "list_artists_api_artists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_ArtistRead_"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "artists"
        ],
        "summary": "Upsert Artist",
        "description": "spotify_id をキーに upsert。既存なら既存を返す (200)。\n\nPhase B-3 PR-2: RecordFormModal が Spotify album を選んだ時、その album の\nartist がまだ DB に無い場合に呼び出す。重複 POST でも 409 を返さない冪等設計。",
        "operationId": "upsert_artist_api_artists_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArtistCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/artists/{spotify_id}": {
      "get": {
        "tags": [
          "artists"
        ],
        "summary": "Get Artist",
        "description": "単一 artist を取り、image_url が NULL なら Spotify から補完する。\n\nArtistDetailModal を開いた時に呼ぶ「lazy photo hydration」エンドポイント。\nSpotify 側エラーは service 層で握り潰されるので、画像が無い場合は\nimage_url=null のまま返る (UI 側で initials fallback)。",
        "operationId": "get_artist_api_artists__spotify_id__get",
        "parameters": [
          {
            "name": "spotify_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Spotify Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/records": {
      "get": {
        "tags": [
          "records"
        ],
        "summary": "List Records",
        "description": "auth 必須。records が user-scope されるのは別 PR (ADR-006) で対応。\n本 PR は「未認証で全レコードが list できる」状態を閉塞するための入口ガード。",
        "operationId": "list_records_api_records_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_VinylRecordRead_"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "records"
        ],
        "summary": "Create Record",
        "description": "record を 1 件作成。RecordService.create が同時に user_follows に\nauto-follow を入れるので、続く release sync で正しく対象になる。",
        "operationId": "create_record_api_records_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VinylRecordCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VinylRecordRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/records/{id}": {
      "put": {
        "tags": [
          "records"
        ],
        "summary": "Update Record",
        "operationId": "update_record_api_records__id__put",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VinylRecordUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VinylRecordRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "records"
        ],
        "summary": "Delete Record",
        "description": "record を物理削除。auth 必須 (POST と揃える)。\n\nuser_follows は意図的に触らないので、最後の 1 件を消しても follow は残り、\n次の sync では引き続き対象になる。",
        "operationId": "delete_record_api_records__id__delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/releases": {
      "get": {
        "tags": [
          "releases"
        ],
        "summary": "List Releases",
        "operationId": "list_releases_api_releases_get",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_ReleaseRead_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/releases/sync-status": {
      "get": {
        "tags": [
          "releases"
        ],
        "summary": "Get Sync Status",
        "operationId": "get_sync_status_api_releases_sync_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatusRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/releases/{spotify_id}/read": {
      "patch": {
        "tags": [
          "releases"
        ],
        "summary": "Set Release Read Status",
        "description": "release の既読フラグをトグル (Feed の未読 dot 用)。\n\nPhase B-3 で localStorage ベースの既読を backend (release.is_read / read_at)\nに移行する経路。`is_read=true` で `read_at=now()`、`false` で `read_at=null`\nに連動して書き換える。auth 必須 (単一ユーザだが将来 multi-user 化で current\nuser が要るため最初から固定)。",
        "operationId": "set_release_read_status_api_releases__spotify_id__read_patch",
        "parameters": [
          {
            "name": "spotify_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Spotify Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseReadStatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/releases/sync": {
      "post": {
        "tags": [
          "releases"
        ],
        "summary": "Trigger Sync",
        "description": "フォロー中アーティスト全件の releases を Spotify から取り込む。\n\nPhase B-3 では同期実行 (long poll、数十秒の可能性)。Phase B-4 で\nAPScheduler の日次バッチに移行する前提のため、ここは shim 実装。",
        "operationId": "trigger_sync_api_releases_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SyncRunRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncRunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/spotify/albums/search": {
      "get": {
        "tags": [
          "spotify"
        ],
        "summary": "Search Albums",
        "operationId": "search_albums_api_spotify_albums_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "album title query",
              "title": "Q"
            },
            "description": "album title query"
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "artist name to refine the query",
              "title": "Artist"
            },
            "description": "artist name to refine the query"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_SpotifyAlbumSummary_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/user-follows/artists": {
      "get": {
        "tags": [
          "user-follows"
        ],
        "summary": "List Followed Artists",
        "description": "現ユーザが follow 中 (archived=false) の artists を返す。\n\nArtistsPage 一覧専用。`GET /api/artists` は global registry (HomePage の\nrecord→artist 名前引きなどで利用) なので別エンドポイントに切る。",
        "operationId": "list_followed_artists_api_user_follows_artists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_ArtistRead_"
                }
              }
            }
          }
        }
      }
    },
    "/api/user-follows/record-counts": {
      "get": {
        "tags": [
          "user-follows"
        ],
        "summary": "List Record Counts",
        "description": "current user の所有レコード数を artist_id ごとに集計して返す。\n\nArtistsPage 一覧の件数列専用。records 全件取得を避けて軽量化する。\n旧 `/api/artists/record-counts` を user-follows 配下に移設し (集計の単位が\nfollow と一致するため意味論として整合する)、同時に user_id でスコープを\n切るようにした。status='owned' のみ数える (want list は除外)。",
        "operationId": "list_record_counts_api_user_follows_record_counts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_ArtistRecordCount_"
                }
              }
            }
          }
        }
      }
    },
    "/api/user-follows/{artist_id}": {
      "delete": {
        "tags": [
          "user-follows"
        ],
        "summary": "Unfollow Artist",
        "description": "Spotify ID の artist を follow から外す (soft delete: archived_flag=true)。\n\narchived_flag を立てるだけなので「以前 follow してた」履歴は残る。\nlist_artist_ids は archived_flag=false のみ返すので、次の release sync は\nこのアーティストを対象から外す。\n\n無いものを消そうとしたら 404、既に archived なら 204 (冪等)。",
        "operationId": "unfollow_artist_api_user_follows__artist_id__delete",
        "parameters": [
          {
            "name": "artist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Artist Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtistCreate": {
        "properties": {
          "spotify_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Spotify Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "source": {
            "type": "string",
            "enum": [
              "seeded",
              "spotify_dynamic",
              "manual"
            ],
            "title": "Source",
            "default": "spotify_dynamic"
          }
        },
        "type": "object",
        "required": [
          "spotify_id",
          "name"
        ],
        "title": "ArtistCreate",
        "description": "新規 artist 作成リクエスト。upsert 動作 (spotify_id 既存なら既存を返す)。\n\nPhase B-3 PR-2 の RecordFormModal が Spotify album を選んだ時、\nその album の artist がまだ DB に無い場合に呼び出す。"
      },
      "ArtistRead": {
        "properties": {
          "spotify_id": {
            "type": "string",
            "title": "Spotify Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "source": {
            "type": "string",
            "enum": [
              "seeded",
              "spotify_dynamic",
              "manual"
            ],
            "title": "Source"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "title": "Added At"
          }
        },
        "type": "object",
        "required": [
          "spotify_id",
          "name",
          "image_url",
          "source",
          "added_at"
        ],
        "title": "ArtistRead"
      },
      "ArtistRecordCount": {
        "properties": {
          "artist_id": {
            "type": "string",
            "title": "Artist Id"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "artist_id",
          "count"
        ],
        "title": "ArtistRecordCount",
        "description": "ArtistsPage 一覧の件数列に渡す軽量行。\n\nrecords 本体は ArtistDetailModal を開くまで fetch しない方針のため、\n一覧では「N records」表示だけ別エンドポイント `/api/user-follows/record-counts`\nから先に取れるようにする (auth 必須、current user 所有 owned のみ集計)。"
      },
      "AuthUserRead": {
        "properties": {
          "spotify_id": {
            "type": "string",
            "title": "Spotify Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "spotify_id",
          "display_name",
          "image_url"
        ],
        "title": "AuthUserRead"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
