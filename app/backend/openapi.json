    "/api/artists": {
      "get": {
        "tags": [
          "artists"
        ],
        "summary": "List Artists",
        "operationId": "list_artists_api_artists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_ArtistRead_"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "artists"
        ],
        "summary": "Upsert Artist",
        "description": "spotify_id をキーに upsert。既存なら既存を返す (200)。\n\nPhase B-3 PR-2: RecordFormModal が Spotify album を選んだ時、その album の\nartist がまだ DB に無い場合に呼び出す。重複 POST でも 409 を返さない冪等設計。",
        "operationId": "upsert_artist_api_artists_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArtistCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/artists/record-counts": {
      "get": {
        "tags": [
          "artists"
        ],
        "summary": "List Record Counts",
        "description": "artist_id ごとの所有レコード数を集計して返す。\n\nArtistsPage 一覧の件数列専用。records 全件取得を避けて軽量化する。",
        "operationId": "list_record_counts_api_artists_record_counts_get",
