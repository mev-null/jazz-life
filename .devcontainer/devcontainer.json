{
  "name": "jazz-life",
  // dockerComposeFile パターン: workspace サービスにアタッチ。
  // db / backend / frontend は ../app/docker-compose.yml 側で別プロジェクトとして
  // 動かし、postStartCommand から `docker compose up -d` で立ち上げる。
  // workspace 内で secrets が露出するので compose interpolation も自然に効く。
  "dockerComposeFile": ["docker-compose.devcontainer.yml"],
  "service": "workspace",
  "workspaceFolder": "/workspaces/jazz-life",
  // workspace を止めるとアプリ側にも触らないので不要な再起動を避ける。
  "shutdownAction": "stopCompose",

  "features": {
    // ホスト daemon と通信する docker CLI を入れる。dind より高速・軽量。
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  "forwardPorts": [8000, 5173, 5432],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "React Frontend",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "Postgres",
      "onAutoForward": "silent"
    }
  },

  "containerEnv": {
    "SPOTIFY_REDIRECT_URI": "http://127.0.0.1:8000/api/auth/callback",
    "FRONTEND_BASE_URL": "http://127.0.0.1:5173",
    "COOKIE_SECURE": "false",
    "VITE_API_BASE": "http://127.0.0.1:8000",
    "VITE_USE_MOCK": "false"
  },
  "secrets": {
    "SPOTIFY_CLIENT_ID": {
      "description": "Spotify app Client ID"
    },
    "SPOTIFY_CLIENT_SECRET": {
      "description": "Spotify app Client Secret"
    },
    "ALLOWED_SPOTIFY_USER_ID": {
      "description": "Owner's Spotify user ID"
    },
    "JWT_SECRET": {
      "description": "JWT signing key"
    },
    "REFRESH_TOKEN_KEY": {
      "description": "Fernet key for encrypting Spotify refresh_token"
    }
  },

  // 初回作成時: app stack を build + up。secrets は workspace shell に存在するので
  // compose interpolation で backend/frontend に流れる。
  "postCreateCommand": "cd /workspaces/jazz-life/app && docker compose up -d",
  // 以降の Codespace 再開時: 既存イメージで再起動するだけ (高速)。
  "postStartCommand": "cd /workspaces/jazz-life/app && docker compose up -d"
}
