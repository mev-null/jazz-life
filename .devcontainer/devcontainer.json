{
  "name": "jazz-life",
  "dockerComposeFile": [
    "docker-compose.devcontainer.yml"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspaces/jazz-life",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },
  "forwardPorts": [
    8000,
    5173,
    5432
  ],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "React Frontend",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "Postgres",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "SPOTIFY_REDIRECT_URI": "http://127.0.0.1:8000/api/auth/callback",
    "FRONTEND_BASE_URL": "http://127.0.0.1:5173",
    "COOKIE_SECURE": "false",
    "COOKIE_SAMESITE": "lax",
    "CORS_ALLOW_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "VITE_API_BASE": "http://127.0.0.1:8000",
    "VITE_USE_MOCK": "false",
    "VITE_ALLOWED_HOSTS": "",
    "VITE_ENABLE_MOBILE_UI": "true"
  },
  "secrets": {
    "SPOTIFY_CLIENT_ID": {
      "description": "Spotify app Client ID"
    },
    "SPOTIFY_CLIENT_SECRET": {
      "description": "Spotify app Client Secret"
    },
    "AUDD_API_TOKEN": {
      "description": "AudD music recognition API token (https://dashboard.audd.io/)"
    },
    "JWT_SECRET": {
      "description": "JWT signing key"
    },
    "REFRESH_TOKEN_KEY": {
      "description": "Fernet key for encrypting Spotify refresh_token"
    }
  },
  // To keep startup fast, a Codespace only brings up db automatically.
  // Run backend / frontend by hand in separate terminals with `cd app/backend && make dev` /
  // `cd app/frontend && make dev` so they stay in the foreground.
  // Secrets are already in the workspace shell, so compose interpolation passes them through even when started later.
  "postCreateCommand": "cd /workspaces/jazz-life/app && docker compose up -d db",
  "postStartCommand": "cd /workspaces/jazz-life/app && docker compose up -d db"
}